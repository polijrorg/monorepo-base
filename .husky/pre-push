BRANCH=$(git rev-parse --abbrev-ref HEAD)

if git show-ref --verify --quiet refs/remotes/origin/"$BRANCH"; then
  CHANGED_FILES=$(git diff --name-only origin/"$BRANCH"...HEAD)
else
  BASE=$(git merge-base HEAD origin/main 2>/dev/null || git rev-list --max-parents=0 HEAD)
  CHANGED_FILES=$(git diff --name-only "$BASE" HEAD)
fi

if echo "$CHANGED_FILES" | grep -q "^web/"; then
  echo "Detected changes in /web. Running typecheck..."
  pnpm --filter web exec tsc --noEmit || exit 1
fi

if echo "$CHANGED_FILES" | grep -q "^mobile/"; then
  echo "Detected changes in /mobile. Running typecheck..."
  pnpm --filter mobile exec tsc --noEmit || exit 1
fi
