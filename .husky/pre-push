BRANCH=$(git rev-parse --abbrev-ref HEAD)

if git show-ref --verify --quiet refs/remotes/origin/"$BRANCH"; then
  CHANGED_FILES=$(git diff --name-only origin/"$BRANCH")
else
  CHANGED_FILES=$(git diff --name-only HEAD~1 HEAD 2>/dev/null || git diff --name-only)
fi

if echo "$CHANGED_FILES" | grep -q "^web/"; then
  echo "Detected changes in /web. Running typecheck..."
  pnpm --filter web tsc --noEmit || exit 1
fi

if echo "$CHANGED_FILES" | grep -q "^mobile/"; then
  echo "Detected changes in /mobile. Running lint..."
  pnpm --filter mobile lint || exit 1
fi
